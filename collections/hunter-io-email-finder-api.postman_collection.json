          "request": {
            "name": "Hunter Find Email",
            "description": {
              "content": "Generates or retrieves the most likely email address from a domain or company name and a person's first and last name (or full name, or LinkedIn handle). Returns score, sources, position, and verification metadata.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "email-finder"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
