                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Domain name of the company."
                },
                {
                  "disabled": false,
                  "key": "company",
                  "value": "<string>",
                  "description": "Company name (used when domain is not provided)."
                },
                {
                  "disabled": false,
                  "key": "first_name",
                  "value": "<string>",
                  "description": "First name of the person."
                },
                {
                  "disabled": false,
                  "key": "last_name",
                  "value": "<string>",
                  "description": "Last name of the person."
                },
                {
                  "disabled": false,
                  "key": "full_name",
                  "value": "<string>",
                  "description": "Full name of the person (alternative to first/last)."
                },
                {
                  "disabled": false,
                  "key": "linkedin_handle",
                  "value": "<string>",
                  "description": "LinkedIn handle (e.g., the slug after `/in/`)."
                },
                {
                  "disabled": false,
                  "key": "max_duration",
                  "value": "10",
                  "description": "Maximum duration of the request in seconds (3-20, default 10)."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your Hunter API key."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
